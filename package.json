{
  "name": "misub-vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --compatibility-date=2024-06-13 --kv MISUB_KV --d1 MISUB_DB --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist",
    "d1:init": "wrangler d1 execute $npm_config_db --file=schema.sql --remote"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "js-yaml": "^4.3.0",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.18",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@vitejs/plugin-vue": "^6.0.1",
    "miniflare": "^4.20250803.0",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.1.12",
    "vite": "^7.3.6",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
